<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Jogo.App.App"
             xmlns:local="using:Jogo.App"
             RequestedThemeVariant="Default">
             <!-- "Default" segue o tema do sistema. O botão do menu alterna entre claro e escuro. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
