<Project Sdk="Microsoft.NET.Sdk">
  <!-- Interface do jogo (Avalonia + MVVM). Única camada que conhece a UI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FootManagerBR</AssemblyName>
    <RootNamespace>Jogo.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icone.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Textos da interface: centralizados aqui para permitir tradução no futuro. -->
    <EmbeddedResource Update="Recursos\Textos.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Jogo.App.Recursos</StronglyTypedNamespace>
      <StronglyTypedClassName>Textos</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Textos.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jogo.Dominio\Jogo.Dominio.csproj" />
    <ProjectReference Include="..\Jogo.Simulacao\Jogo.Simulacao.csproj" />
    <ProjectReference Include="..\Jogo.Dados\Jogo.Dados.csproj" />
  </ItemGroup>
</Project>
