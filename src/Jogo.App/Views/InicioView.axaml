<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jogo.App.ViewModels"
             x:Class="Jogo.App.Views.InicioView"
             x:DataType="vm:InicioViewModel">

    <StackPanel Margin="32" Spacing="8">
        <TextBlock Text="{Binding Titulo}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitulo}" Opacity="0.75" TextWrapping="Wrap" />
    </StackPanel>

</UserControl>
