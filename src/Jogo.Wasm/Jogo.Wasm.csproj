<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    Ponte entre o núcleo do jogo (C#) e a interface web (React + TypeScript).
    Compila para WebAssembly e só repassa as chamadas para Jogo.Aplicacao.ApiJson ([JSExport], JSON).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Jogo.Wasm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jogo.Aplicacao\Jogo.Aplicacao.csproj" />
  </ItemGroup>
</Project>
