# Normaliza finais de linha no repositório.
* text=auto
*.cs     text diff=csharp
*.axaml  text
*.json   text
*.md     text
*.sh     text eol=lf
*.ico    binary
*.png    binary
*.db     binary

# Definições geradas: sempre LF, para bater byte a byte com o gerador em qualquer sistema.
dados/**/*.json text eol=lf
